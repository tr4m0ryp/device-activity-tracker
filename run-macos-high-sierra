#!/bin/bash

# Device Activity Tracker - macOS High Sierra Setup & Run Script
# ================================================================
# Uses Docker Toolbox to run the project in a Linux container
# This bypasses the Node.js 20+ macOS compatibility issue
# 
# NO HOMEBREW REQUIRED - Direct downloads only
# ================================================================

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Download URLs for direct installation (no Homebrew)
DOCKER_TOOLBOX_VERSION="19.03.1"
DOCKER_TOOLBOX_URL="https://github.com/docker-archive/toolbox/releases/download/v${DOCKER_TOOLBOX_VERSION}/DockerToolbox-${DOCKER_TOOLBOX_VERSION}.pkg"

# VirtualBox 6.1.50 - last version that supports High Sierra
VIRTUALBOX_VERSION="6.1.50"
VIRTUALBOX_DMG="VirtualBox-${VIRTUALBOX_VERSION}-161033-OSX.dmg"
VIRTUALBOX_URL="https://download.virtualbox.org/virtualbox/${VIRTUALBOX_VERSION}/${VIRTUALBOX_DMG}"

echo -e "${CYAN}======================================================${NC}"
echo -e "${CYAN}  Device Activity Tracker - macOS High Sierra Setup   ${NC}"
echo -e "${CYAN}  Using Docker Toolbox for Node.js 20+ Compatibility  ${NC}"
echo -e "${CYAN}======================================================${NC}"
echo -e "${YELLOW}  No Homebrew required - Direct downloads only       ${NC}"
echo -e "${CYAN}======================================================${NC}\n"

# Function to print section headers
print_section() {
    echo -e "\n${BLUE}>>> $1${NC}"
}

print_success() {
    echo -e "${GREEN}[OK]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[!]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Check if running on macOS
check_macos() {
    if [[ "$(uname)" != "Darwin" ]]; then
        print_error "This script is for macOS only."
        print_warning "For Linux, use the './run' script instead."
        exit 1
    fi
    
    MACOS_VERSION=$(sw_vers -productVersion)
    echo "Detected macOS version: $MACOS_VERSION"
    
    MACOS_MAJOR=$(echo "$MACOS_VERSION" | cut -d. -f1)
    MACOS_MINOR=$(echo "$MACOS_VERSION" | cut -d. -f2)
    
    # If running Catalina or later, suggest using regular run script
    if [[ "$MACOS_MAJOR" -ge 11 ]] || [[ "$MACOS_MAJOR" -eq 10 && "$MACOS_MINOR" -ge 15 ]]; then
        echo ""
        print_success "Your macOS version ($MACOS_VERSION) supports Node.js 20+ natively!"
        print_warning "You can use the simpler './run' script instead."
        echo ""
        read -p "Continue with Docker anyway? (y/n) " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo "Use './run' for native setup."
            exit 0
        fi
    fi
}

# Check and install VirtualBox (required for Docker Toolbox)
check_virtualbox() {
    print_section "Checking VirtualBox..."
    
    if command -v VBoxManage &> /dev/null; then
        VB_VERSION=$(VBoxManage --version | cut -d'r' -f1)
        print_success "VirtualBox $VB_VERSION is installed"
        return 0
    fi
    
    print_warning "VirtualBox not found."
    echo ""
    echo "VirtualBox is required for Docker Toolbox."
    echo ""
    echo "Please download and install VirtualBox ${VIRTUALBOX_VERSION}:"
    echo ""
    echo -e "  ${CYAN}${VIRTUALBOX_URL}${NC}"
    echo ""
    echo "Installation steps:"
    echo "  1. Download the DMG file"
    echo "  2. Open the DMG and run VirtualBox.pkg"
    echo "  3. If blocked, go to System Preferences > Security & Privacy"
    echo "     and click 'Allow' for Oracle"
    echo "  4. Re-run this script after installation"
    echo ""
    
    read -p "Download VirtualBox now? (y/n) " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        echo "Downloading VirtualBox..."
        cd ~/Downloads
        curl -L -O "$VIRTUALBOX_URL"
        echo ""
        print_success "Downloaded to ~/Downloads/${VIRTUALBOX_DMG}"
        echo ""
        echo "Opening the DMG file..."
        open ~/Downloads/${VIRTUALBOX_DMG}
        echo ""
        print_warning "Please complete the VirtualBox installation, then run this script again."
    fi
    
    exit 1
}

# Check and install Docker Toolbox
check_docker_toolbox() {
    print_section "Checking Docker Toolbox..."
    
    if command -v docker-machine &> /dev/null && command -v docker &> /dev/null; then
        print_success "Docker Toolbox is installed"
        return 0
    fi
    
    print_warning "Docker Toolbox not found."
    echo ""
    echo "Please download and install Docker Toolbox:"
    echo ""
    echo -e "  ${CYAN}${DOCKER_TOOLBOX_URL}${NC}"
    echo ""
    echo "Installation steps:"
    echo "  1. Download the .pkg file"
    echo "  2. Open and run the installer"
    echo "  3. Re-run this script after installation"
    echo ""
    
    read -p "Download Docker Toolbox now? (y/n) " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        echo "Downloading Docker Toolbox..."
        cd ~/Downloads
        curl -L -O "$DOCKER_TOOLBOX_URL"
        echo ""
        print_success "Downloaded to ~/Downloads/DockerToolbox-${DOCKER_TOOLBOX_VERSION}.pkg"
        echo ""
        echo "Opening the installer..."
        open ~/Downloads/DockerToolbox-${DOCKER_TOOLBOX_VERSION}.pkg
        echo ""
        print_warning "Please complete the Docker Toolbox installation, then run this script again."
    fi
    
    exit 1
}

# Initialize Docker Machine (the Linux VM that runs Docker)
init_docker_machine() {
    print_section "Initializing Docker Machine..."
    
    # Check if default machine exists
    if docker-machine ls 2>/dev/null | grep -q "^default"; then
        MACHINE_STATUS=$(docker-machine status default 2>/dev/null || echo "Unknown")
        
        if [[ "$MACHINE_STATUS" == "Running" ]]; then
            print_success "Docker machine 'default' is running"
        else
            print_warning "Starting Docker machine 'default'..."
            docker-machine start default
            print_success "Docker machine started"
        fi
    else
        print_warning "Creating Docker machine 'default'..."
        echo "This will create a Linux VM in VirtualBox (may take a few minutes)..."
        docker-machine create --driver virtualbox default
        print_success "Docker machine created"
    fi
    
    # Set up environment
    print_section "Setting up Docker environment..."
    eval $(docker-machine env default)
    print_success "Docker environment configured"
    
    # Verify Docker is working
    if docker info &> /dev/null; then
        print_success "Docker is working"
    else
        print_error "Docker is not responding. Try: docker-machine restart default"
        exit 1
    fi
}

# Create Dockerfile for the project
create_dockerfile() {
    print_section "Creating Dockerfile..."
    
    cat > "$SCRIPT_DIR/Dockerfile.highsierra" << 'DOCKERFILE'
# Device Activity Tracker - Docker Container
# For running on macOS High Sierra via Docker Toolbox

FROM node:20-alpine

# Install dependencies for native modules
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    git \
    bash

# Create app directory
WORKDIR /app

# Copy package files first for better caching
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy the rest of the application
COPY . .

# Build TypeScript
RUN npm run build

# Expose port for the web client
EXPOSE 3000

# Default command - can be overridden
CMD ["npm", "start"]
DOCKERFILE

    print_success "Dockerfile created at Dockerfile.highsierra"
}

# Create docker-compose file
create_docker_compose() {
    print_section "Creating docker-compose configuration..."
    
    cat > "$SCRIPT_DIR/docker-compose.highsierra.yml" << 'DOCKERCOMPOSE'
version: '3.8'

services:
  tracker:
    build:
      context: .
      dockerfile: Dockerfile.highsierra
    container_name: device-activity-tracker
    volumes:
      # Persist authentication data
      - ./auth_info_baileys:/app/auth_info_baileys
      # Persist Signal data if used
      - ./signal-data:/app/signal-data
    ports:
      - "3000:3000"
    stdin_open: true
    tty: true
    restart: unless-stopped

  # Optional: Signal tracker with signald
  signald:
    image: signald/signald:latest
    container_name: signald
    volumes:
      - ./signald-data:/signald
    restart: unless-stopped
    profiles:
      - signal
DOCKERCOMPOSE

    print_success "docker-compose.highsierra.yml created"
}

# Build the Docker image
build_docker_image() {
    print_section "Building Docker image..."
    echo "This may take a few minutes on first run..."
    
    cd "$SCRIPT_DIR"
    docker build -f Dockerfile.highsierra -t device-activity-tracker:latest .
    
    print_success "Docker image built successfully"
}

# Run the tracker
run_tracker() {
    print_section "Starting Device Activity Tracker..."
    
    cd "$SCRIPT_DIR"
    
    # Make sure Docker environment is set
    eval $(docker-machine env default 2>/dev/null) || true
    
    # Check if container already exists
    if docker ps -a | grep -q "device-activity-tracker"; then
        print_warning "Removing existing container..."
        docker rm -f device-activity-tracker 2>/dev/null || true
    fi
    
    echo ""
    echo -e "${GREEN}======================================================${NC}"
    echo -e "${GREEN}  Device Activity Tracker is starting!                ${NC}"
    echo -e "${GREEN}======================================================${NC}"
    echo ""
    echo "The tracker will run interactively in this terminal."
    echo "You'll see a QR code to scan with WhatsApp."
    echo ""
    echo -e "${YELLOW}Press Ctrl+C to stop the tracker.${NC}"
    echo ""
    
    # Get Docker machine IP for display
    DOCKER_IP=$(docker-machine ip default 2>/dev/null || echo "localhost")
    echo -e "${CYAN}Web interface will be at: http://${DOCKER_IP}:3000${NC}"
    echo ""
    
    # Run interactively with TTY
    docker run -it --rm \
        --name device-activity-tracker \
        -v "$SCRIPT_DIR/auth_info_baileys:/app/auth_info_baileys" \
        -p 3000:3000 \
        device-activity-tracker:latest \
        npm start
}

# Show menu
show_menu() {
    echo ""
    echo -e "${CYAN}What would you like to do?${NC}"
    echo ""
    echo "  1) Start WhatsApp Tracker"
    echo "  2) Start WhatsApp Tracker with Signal support"
    echo "  3) Rebuild Docker image (after code changes)"
    echo "  4) Open web client in browser"
    echo "  5) Check Docker status"
    echo "  6) Stop all containers"
    echo "  7) Exit"
    echo ""
    read -p "Enter choice [1-7]: " choice
    
    case $choice in
        1)
            run_tracker
            ;;
        2)
            run_with_signal
            ;;
        3)
            build_docker_image
            show_menu
            ;;
        4)
            open_web_client
            ;;
        5)
            check_docker_status
            show_menu
            ;;
        6)
            stop_containers
            show_menu
            ;;
        7)
            echo "Goodbye!"
            exit 0
            ;;
        *)
            print_error "Invalid choice"
            show_menu
            ;;
    esac
}

# Run with Signal support
run_with_signal() {
    print_section "Starting with Signal support..."
    
    cd "$SCRIPT_DIR"
    eval $(docker-machine env default 2>/dev/null) || true
    docker-compose -f docker-compose.highsierra.yml --profile signal up
}

# Open web client
open_web_client() {
    # Get Docker machine IP
    DOCKER_IP=$(docker-machine ip default 2>/dev/null || echo "localhost")
    
    echo ""
    echo -e "${CYAN}Opening web client...${NC}"
    echo "URL: http://${DOCKER_IP}:3000"
    echo ""
    
    open "http://${DOCKER_IP}:3000"
}

# Check Docker status
check_docker_status() {
    print_section "Docker Status"
    
    eval $(docker-machine env default 2>/dev/null) || true
    
    echo ""
    echo "Docker Machine:"
    docker-machine ls
    
    echo ""
    echo "Running Containers:"
    docker ps
    
    echo ""
    echo "Docker Machine IP: $(docker-machine ip default 2>/dev/null || echo 'Not running')"
}

# Stop all containers
stop_containers() {
    print_section "Stopping containers..."
    
    eval $(docker-machine env default 2>/dev/null) || true
    docker-compose -f docker-compose.highsierra.yml down 2>/dev/null || true
    docker rm -f device-activity-tracker 2>/dev/null || true
    
    print_success "All containers stopped"
}

# Main script execution
main() {
    check_macos
    check_virtualbox
    check_docker_toolbox
    init_docker_machine
    
    # Create Docker files if they don't exist
    if [[ ! -f "$SCRIPT_DIR/Dockerfile.highsierra" ]]; then
        create_dockerfile
    fi
    
    if [[ ! -f "$SCRIPT_DIR/docker-compose.highsierra.yml" ]]; then
        create_docker_compose
    fi
    
    # Build image if it doesn't exist
    eval $(docker-machine env default 2>/dev/null) || true
    if ! docker images | grep -q "device-activity-tracker"; then
        build_docker_image
    fi
    
    # Show menu
    show_menu
}

# Run main
main
